@model IEnumerable<QuranCenterApp.Models.Teacher>
@{
    ViewData["Title"] = "المعلمون";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-person-badge me-2" style="color:var(--gold)"></i>قائمة المعلمين</h2>
        <p class="page-subtitle">إدارة بيانات المعلمين في المركز</p>
    </div>
    <a asp-action="Create" class="btn btn-gold px-4"><i class="bi bi-person-plus me-1"></i>إضافة معلم</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الاسم الكامل</th>
                        <th>التخصص</th>
                        <th>تاريخ التعيين</th>
                        <th>الفصول</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4" style="color:var(--text-muted)">لا يوجد معلمون.</td></tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td style="color:var(--text-muted)">@t.TeacherID</td>
                            <td><i class="bi bi-person-badge me-1" style="color:var(--gold)"></i>@t.Person.FirstName @t.Person.LastName</td>
                            <td>@t.Specialization</td>
                            <td>@t.HireDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge" style="background:var(--bg-row);color:var(--gold);border:1px solid var(--border)">@t.Classrooms.Count فصل</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@t.TeacherID" class="btn btn-sm btn-outline-info me-1"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit"    asp-route-id="@t.TeacherID" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete"  asp-route-id="@t.TeacherID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer small">الإجمالي: @Model.Count() معلم</div>
</div>
