@model QuranCenterApp.Models.Teacher
@{
    ViewData["Title"] = "Teacher Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-person-badge me-2 text-primary"></i>Teacher Profile</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.TeacherID" class="btn btn-warning me-2"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:80px;height:80px">
                    <i class="bi bi-person-badge text-white fs-1"></i>
                </div>
                <h4 class="fw-bold">@Model.Person.FirstName @Model.Person.LastName</h4>
                <p class="text-muted">@Model.Specialization</p>
                <hr />
                <div class="text-start">
                    <p><i class="bi bi-envelope me-2 text-muted"></i>@(Model.Person.Email ?? "N/A")</p>
                    <p><i class="bi bi-calendar me-2 text-muted"></i>Hired: @Model.HireDate.ToString("dd/MM/yyyy")</p>
                    <p><i class="bi bi-gender-ambiguous me-2 text-muted"></i>@(Model.Person.Gender == "M" ? "Male" : "Female")</p>
                    @foreach (var ph in Model.Person.PhoneNumbers)
                    {
                        <p><i class="bi bi-telephone me-2 text-muted"></i>@ph.Phone</p>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-door-open me-2"></i>Assigned Classrooms (@Model.Classrooms.Count)
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Classroom</th><th>Max Size</th><th>Curriculum</th></tr></thead>
                    <tbody>
                        @if (!Model.Classrooms.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No classrooms assigned</td></tr>
                        }
                        @foreach (var c in Model.Classrooms)
                        {
                            <tr>
                                <td>@c.ClassroomName</td>
                                <td>@c.MaxSize</td>
                                <td>@c.Curriculum?.CurriculumName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
