@model QuranCenterApp.Models.Supervisor
@{
    ViewData["Title"] = "تفاصيل المشرف";
    var levelAr = new Dictionary<string, string> {
        {"Beginner","مبتدئ"}, {"Intermediate","متوسط"}, {"Advanced","متقدم"}
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-shield-check me-2" style="color:var(--gold)"></i>تفاصيل المشرف</h2>
        <p class="page-subtitle">@Model.Person.FirstName @Model.Person.LastName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.SupervisorID" class="btn btn-outline-warning"><i class="bi bi-pencil me-1"></i>تعديل</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>رجوع</a>
    </div>
</div>

<!-- البيانات الشخصية -->
<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-person me-2" style="color:var(--gold)"></i>البيانات الشخصية</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">الاسم الكامل</dt>
                    <dd class="col-7">@Model.Person.FirstName @Model.Person.LastName</dd>

                    <dt class="col-5">الجنس</dt>
                    <dd class="col-7">@(Model.Person.Gender == "M" ? "ذكر" : "أنثى")</dd>

                    <dt class="col-5">تاريخ الميلاد</dt>
                    <dd class="col-7" dir="ltr" style="text-align:right">@Model.Person.DateOfBirth.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-5">البريد الإلكتروني</dt>
                    <dd class="col-7">@(Model.Person.Email ?? "—")</dd>

                    <dt class="col-5">القسم</dt>
                    <dd class="col-7"><span class="badge" style="background:rgba(200,168,75,.2);color:var(--gold);border:1px solid var(--gold)">@Model.Department</span></dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-bar-chart me-2" style="color:var(--gold)"></i>إحصائيات</div>
            <div class="card-body d-flex align-items-center justify-content-around text-center">
                <div>
                    <div class="fs-2 fw-bold" style="color:var(--gold)">@Model.Classrooms.Count</div>
                    <div style="color:var(--text-muted);font-size:.85rem">الفصول المُشرَف عليها</div>
                </div>
                <div style="width:1px;background:var(--border);height:60px"></div>
                <div>
                    <div class="fs-2 fw-bold" style="color:var(--gold)">@Model.Classrooms.Sum(c => c.Enrollments.Count)</div>
                    <div style="color:var(--text-muted);font-size:.85rem">إجمالي الطلاب</div>
                </div>
                <div style="width:1px;background:var(--border);height:60px"></div>
                <div>
                    <div class="fs-2 fw-bold" style="color:var(--gold)">@Model.Classrooms.Sum(c => c.MaxSize)</div>
                    <div style="color:var(--text-muted);font-size:.85rem">مجموع المقاعد</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- الفصول -->
<div class="card">
    <div class="card-header"><i class="bi bi-door-open me-2" style="color:var(--gold)"></i>الفصول المُشرَف عليها (@Model.Classrooms.Count)</div>
    <div class="card-body p-0">
        @if (!Model.Classrooms.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted)">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>لا يوجد فصول مرتبطة بهذا المشرف.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>اسم الفصل</th>
                        <th>المنهج</th>
                        <th>المعلم</th>
                        <th>المستوى المطلوب</th>
                        <th>الطلاب / المقاعد</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Classrooms)
                    {
                        var pct = c.MaxSize > 0 ? (int)Math.Round((double)c.Enrollments.Count / c.MaxSize * 100) : 0;
                        <tr>
                            <td><strong style="color:var(--gold)">@c.ClassroomName</strong></td>
                            <td>@c.Curriculum?.CurriculumName</td>
                            <td>@c.Teacher?.Person?.FirstName @c.Teacher?.Person?.LastName</td>
                            <td><span class="badge bg-secondary">@(levelAr.GetValueOrDefault(c.RequiredLevel, c.RequiredLevel))</span></td>
                            <td>
                                <div style="font-size:.85rem;margin-bottom:4px">@c.Enrollments.Count / @c.MaxSize</div>
                                <div class="progress" style="height:6px;width:90px">
                                    <div class="progress-bar" style="width:@pct%;background:var(--gold)"></div>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="Classrooms" asp-action="Details" asp-route-id="@c.ClassroomID"
                                   class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
