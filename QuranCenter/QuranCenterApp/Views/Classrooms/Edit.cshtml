@model QuranCenterApp.Models.Classroom
@{
    ViewData["Title"] = "تعديل الفصل";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-pencil-square me-2" style="color:var(--gold)"></i>تعديل الفصل</h2>
        <p class="page-subtitle">@Model.ClassroomName</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>رجوع</a>
</div>

<div class="card">
    <div class="card-header" style="color:var(--gold)">تعديل: @Model.ClassroomName</div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-3">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div><i class="bi bi-exclamation-triangle me-1"></i>@error.ErrorMessage</div>
                }
            </div>
        }
        <form asp-action="Edit" method="post">            <input type="hidden" asp-for="ClassroomID" />
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">اسم الفصل</label>
                    <input asp-for="ClassroomName" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">الحد الأقصى للطلاب</label>
                    <input asp-for="MaxSize" type="number" min="1" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">المنهج</label>
                    <select asp-for="CurriculumID" asp-items="ViewBag.CurriculumID" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">المعلم</label>
                    <select asp-for="TeacherID" asp-items="ViewBag.TeacherID" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">المشرف (اختياري)</label>
                    <select asp-for="SupervisorID" asp-items="ViewBag.SupervisorID" class="form-select">
                        <option value="">-- بدون مشرف --</option>
                    </select>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-gold px-4"><i class="bi bi-save me-1"></i>تحديث</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

