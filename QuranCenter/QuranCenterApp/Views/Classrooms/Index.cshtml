@model IEnumerable<QuranCenterApp.Models.Classroom>
@{
    ViewData["Title"] = "Classrooms";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-door-open me-2 text-warning"></i>Classrooms</h2>
    <a asp-action="Create" class="btn btn-warning text-dark"><i class="bi bi-plus-circle me-1"></i>New Classroom</a>
</div>

<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-5">No classrooms found.</div>
    }
    @foreach (var c in Model)
    {
        var enrolled = c.Enrollments.Count;
        var pct = c.MaxSize > 0 ? (enrolled * 100 / c.MaxSize) : 0;
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center bg-warning text-dark">
                    <span class="fw-bold">@c.ClassroomName</span>
                    <span class="badge bg-dark">@c.Curriculum.Category</span>
                </div>
                <div class="card-body">
                    <p class="mb-1"><i class="bi bi-book me-2 text-muted"></i>@c.Curriculum.CurriculumName</p>
                    <p class="mb-1"><i class="bi bi-person-badge me-2 text-muted"></i>@c.Teacher.Person.FirstName @c.Teacher.Person.LastName</p>
                    <p class="mb-2">
                        <i class="bi bi-people me-2 text-muted"></i>
                        @enrolled / @c.MaxSize students
                    </p>
                    <div class="progress" style="height:8px">
                        <div class="progress-bar @(pct>=90?"bg-danger":pct>=70?"bg-warning":"bg-success")"
                             style="width:@pct%"></div>
                    </div>
                    <small class="text-muted">@pct% full</small>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@c.ClassroomID" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Details</a>
                    <a asp-action="Edit" asp-route-id="@c.ClassroomID" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@c.ClassroomID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </div>
            </div>
        </div>
    }
</div>
