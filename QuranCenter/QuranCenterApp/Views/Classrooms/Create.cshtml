@model QuranCenterApp.Models.Classroom
@{
    ViewData["Title"] = "فصل جديد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-plus-circle me-2" style="color:var(--gold)"></i>إنشاء فصل جديد</h2>
        <p class="page-subtitle">تعبئة بيانات الفصل الدراسي</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>رجوع</a>
</div>

<div class="card">
    <div class="card-header" style="color:var(--gold)">
        <i class="bi bi-door-open me-2"></i>بيانات الفصل
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-3">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div><i class="bi bi-exclamation-triangle me-1"></i>@error.ErrorMessage</div>
                }
            </div>
        }
        <form asp-action="Create" method="post">            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">اسم الفصل <span class="text-danger">*</span></label>
                    <input asp-for="ClassroomName" class="form-control" placeholder="مثال: فصل القرآن أ" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">الحد الأقصى للطلاب <span class="text-danger">*</span></label>
                    <input asp-for="MaxSize" type="number" min="1" max="100" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">المعلم <span class="text-danger">*</span></label>
                    <select asp-for="TeacherID" asp-items="ViewBag.TeacherID" class="form-select">
                        <option value="">-- اختر المعلم --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">المنهج <span class="text-danger">*</span></label>
                    <select asp-for="CurriculumID" asp-items="ViewBag.CurriculumID" class="form-select">
                        <option value="">-- اختر المنهج --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">المشرف (اختياري)</label>
                    <select asp-for="SupervisorID" asp-items="ViewBag.SupervisorID" class="form-select">
                        <option value="">-- بدون مشرف --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">المستوى المطلوب <span class="text-danger">*</span></label>
                    <select asp-for="RequiredLevel" class="form-select">
                        <option value="Beginner">مبتدئ</option>
                        <option value="Intermediate">متوسط</option>
                        <option value="Advanced">متقدم</option>
                    </select>
                    <small style="color:var(--text-muted)">الحد الأدنى لمستوى الطالب للانضمام</small>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-gold px-4">
                    <i class="bi bi-save me-1"></i>إنشاء الفصل
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

