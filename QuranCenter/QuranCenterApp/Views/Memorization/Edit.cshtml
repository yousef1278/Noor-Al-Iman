@model QuranCenterApp.Models.Memorization
@{
    ViewData["Title"] = "تعديل سجل الحفظ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-pencil-square me-2" style="color:var(--gold)"></i>تعديل سجل الحفظ</h2>
        <p class="page-subtitle">تحديث بيانات سجل الحفظ</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>رجوع</a>
</div>

<div class="card">
    <div class="card-header">
        <i class="bi bi-pencil me-2" style="color:var(--gold)"></i>تعديل البيانات
    </div>
    <div class="card-body">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MemorizationID" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">الطالب <span style="color:#ff6b6b">*</span></label>
                    <select asp-for="StudentID" asp-items="ViewBag.StudentID" class="form-select"></select>
                    <span asp-validation-for="StudentID" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">اسم السورة <span style="color:#ff6b6b">*</span></label>
                    <input asp-for="SurahName" class="form-control" list="surahList" />
                    <datalist id="surahList">
                        <option value="الفاتحة"></option><option value="البقرة"></option><option value="آل عمران"></option>
                        <option value="النساء"></option><option value="المائدة"></option><option value="الأنعام"></option>
                        <option value="الكهف"></option><option value="يس"></option><option value="الملك"></option>
                        <option value="الناس"></option><option value="الفلق"></option><option value="الإخلاص"></option>
                        <option value="Al-Fatiha"></option><option value="Al-Baqara"></option><option value="Al-Imran"></option>
                    </datalist>
                    <span asp-validation-for="SurahName" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">من الآية <span style="color:#ff6b6b">*</span></label>
                    <input asp-for="FromAyah" type="number" min="1" max="286" class="form-control" />
                    <span asp-validation-for="FromAyah" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">إلى الآية <span style="color:#ff6b6b">*</span></label>
                    <input asp-for="ToAyah" type="number" min="1" max="286" class="form-control" />
                    <span asp-validation-for="ToAyah" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">تاريخ الإتمام <span style="color:#ff6b6b">*</span></label>
                    <input asp-for="DateCompleted" type="date" lang="en-GB" dir="ltr" class="form-control" />
                    <span asp-validation-for="DateCompleted" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">التقييم (1-5)</label>
                    <input asp-for="Rating" type="number" min="1" max="5" class="form-control" placeholder="اختياري" />
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-gold px-4">
                    <i class="bi bi-save me-1"></i>تحديث
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
