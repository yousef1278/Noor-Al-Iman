@model IEnumerable<QuranCenterApp.Models.Memorization>
@{
    ViewData["Title"] = "سجل الحفظ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-bookmark-star me-2" style="color:var(--gold)"></i>سجل الحفظ</h2>
        <p class="page-subtitle">تتبع تقدم الطلاب في حفظ القرآن الكريم</p>
    </div>
    <a asp-action="Create" class="btn btn-gold px-4">
        <i class="bi bi-bookmark-plus me-1"></i>إضافة سجل
    </a>
</div>

<!-- Filter -->
<div class="card mb-4">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">تصفية حسب الطالب</label>
                <select name="studentId" asp-items="ViewBag.Students" class="form-select form-select-sm">
                    <option value="">جميع الطلاب</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-gold"><i class="bi bi-search"></i> تصفية</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>الطالب</th>
                        <th>السورة</th>
                        <th>الآيات</th>
                        <th>تاريخ الإتمام</th>
                        <th>التقييم</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4" style="color:var(--text-muted)">لا توجد سجلات حفظ.</td></tr>
                    }
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>@m.Student.Person.FirstName @m.Student.Person.LastName</td>
                            <td><i class="bi bi-book me-1" style="color:var(--gold)"></i>@m.SurahName</td>
                            <td>
                                <span class="badge" style="background:var(--bg-row);color:var(--gold);border:1px solid var(--border)">
                                    @m.FromAyah - @m.ToAyah
                                </span>
                            </td>
                            <td>@m.DateCompleted.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (m.Rating.HasValue)
                                {
                                    for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi bi-star@(i <= m.Rating ? "-fill" : "")" style="color:@(i <= m.Rating ? "var(--gold)" : "var(--border)")"></i>
                                    }
                                }
                                else { <span style="color:var(--text-muted)">-</span> }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@m.MemorizationID" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@m.MemorizationID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer small">الإجمالي: @Model.Count() سجل</div>
</div>
