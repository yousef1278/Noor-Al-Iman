@model IEnumerable<QuranCenterApp.Models.Attendance>
@{
    ViewData["Title"] = "الحضور";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-calendar-check me-2" style="color:var(--gold)"></i>سجل الحضور</h2>
        <p class="page-subtitle">تتبع حضور وغياب الطلاب</p>
    </div>
    <a asp-action="Create" class="btn btn-gold px-4"><i class="bi bi-calendar-plus me-1"></i>تسجيل حضور</a>
</div>

<!-- فلتر -->
<div class="card mb-4">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">الفصل</label>
                <select name="classroomId" asp-items="ViewBag.Classrooms" class="form-select form-select-sm">
                    <option value="">جميع الفصول</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">التاريخ</label>
                <input type="date" lang="en-GB" dir="ltr" name="date" value="@(ViewBag.FilterDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-gold"><i class="bi bi-search"></i> بحث</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>الطالب</th>
                        <th>الفصل</th>
                        <th>التاريخ</th>
                        <th>الحالة</th>
                        <th>ملاحظات</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4" style="color:var(--text-muted)">لا توجد سجلات حضور.</td></tr>
                    }
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Student.Person.FirstName @a.Student.Person.LastName</td>
                            <td>@a.Classroom.ClassroomName</td>
                            <td>@a.AttendanceDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @{
                                    var (statusAr, statusCss) = a.Status switch {
                                        "P" => ("حاضر",  "background:#1a6b3a;color:#fff"),
                                        "A" => ("غائب",  "background:#dc3545;color:#fff"),
                                        "L" => ("متأخر", "background:#c8a84b;color:#0d2818"),
                                        _   => (a.Status, "background:#666;color:#fff")
                                    };
                                }
                                <span class="badge" style="@statusCss">@statusAr</span>
                            </td>
                            <td>@(a.Notes ?? "-")</td>
                            <td>
                                <a asp-action="Edit"   asp-route-id="@a.AttendanceID" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@a.AttendanceID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer small">
        الإجمالي: @Model.Count() سجل &nbsp;|&nbsp;
        حاضر: @Model.Count(a => a.Status == "P") &nbsp;|&nbsp;
        غائب: @Model.Count(a => a.Status == "A") &nbsp;|&nbsp;
        متأخر: @Model.Count(a => a.Status == "L")
    </div>
</div>
