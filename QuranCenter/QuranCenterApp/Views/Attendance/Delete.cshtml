@model QuranCenterApp.Models.Attendance
@{
    ViewData["Title"] = "Delete Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-danger"><i class="bi bi-trash me-2"></i>Delete Attendance Record</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">Confirm Deletion</div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student</dt><dd class="col-sm-9">@Model.Student.Person.FirstName @Model.Student.Person.LastName</dd>
            <dt class="col-sm-3">Classroom</dt><dd class="col-sm-9">@Model.Classroom.ClassroomName</dd>
            <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.AttendanceDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.Status == "P" ? "Present" : Model.Status == "A" ? "Absent" : "Late")</dd>
        </dl>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AttendanceID" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            <a asp-action="Index" class="btn btn-light ms-2">Cancel</a>
        </form>
    </div>
</div>
