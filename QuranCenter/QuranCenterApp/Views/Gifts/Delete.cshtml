@model QuranCenterApp.Models.Gift
@{
    ViewData["Title"] = "Delete Gift";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-danger"><i class="bi bi-trash me-2"></i>Delete Gift</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">Confirm Deletion</div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Gift Name</dt><dd class="col-sm-9">@Model.GiftName</dd>
            <dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.GiftType</dd>
            <dt class="col-sm-3">Quantity</dt><dd class="col-sm-9">@Model.Quantity</dd>
        </dl>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="GiftID" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            <a asp-action="Index" class="btn btn-light ms-2">Cancel</a>
        </form>
    </div>
</div>
