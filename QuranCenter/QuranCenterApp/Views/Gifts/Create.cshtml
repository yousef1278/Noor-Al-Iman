@model QuranCenterApp.Models.Gift
@{
    ViewData["Title"] = "إضافة هدية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-gift me-2" style="color:var(--gold)"></i>إضافة هدية جديدة</h2>
        <p class="page-subtitle">إضافة هدية إلى مخزون المركز</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>رجوع</a>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-gift me-2" style="color:var(--gold)"></i>تفاصيل الهدية</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">اسم الهدية <span class="text-danger">*</span></label>
                    <input asp-for="GiftName" class="form-control" placeholder="مثال: مصحف شريف" required />
                    <span asp-validation-for="GiftName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">نوع الهدية <span class="text-danger">*</span></label>
                    <select asp-for="GiftType" class="form-select">
                        <option value="Book">كتاب</option>
                        <option value="Item">هدية</option>
                        <option value="Award">جائزة</option>
                        <option value="Other">أخرى</option>
                    </select>
                    <span asp-validation-for="GiftType" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label class="form-label">الكمية <span class="text-danger">*</span></label>
                    <input asp-for="Quantity" type="number" min="0" class="form-control" required />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-gold px-4"><i class="bi bi-save me-1"></i>حفظ</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>
