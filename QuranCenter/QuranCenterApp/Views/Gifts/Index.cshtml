@model IEnumerable<QuranCenterApp.Models.Gift>
@{
    ViewData["Title"] = "الهدايا";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-gift me-2" style="color:var(--gold)"></i>مخزون الهدايا</h2>
        <p class="page-subtitle">إدارة الهدايا المتاحة للتوزيع على الطلاب</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create"    class="btn btn-gold"><i class="bi bi-plus-circle me-1"></i>إضافة هدية</a>
        <a asp-action="Distribute" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-right me-1"></i>توزيع</a>
    </div>
</div>

<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5" style="color:var(--text-muted)">لا توجد هدايا في المخزون.</div>
    }
    @foreach (var g in Model)
    {
        <div class="col-md-3">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <div style="font-size:2.5rem; color:var(--gold)">🎁</div>
                    <h5 class="fw-bold mt-2" style="color:#fff">@g.GiftName</h5>
                    <span class="badge" style="background:var(--bg-row);color:var(--gold);border:1px solid var(--border)">@g.GiftType</span>
                    <div class="mt-3">
                        <span class="fs-3 fw-bold" style="color:@(g.Quantity==0?"#dc3545":"var(--gold)")">@g.Quantity</span>
                        <small style="color:var(--text-muted); display:block">متبقي في المخزون</small>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-center gap-2">
                    <a asp-action="Edit"   asp-route-id="@g.GiftID" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@g.GiftID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </div>
            </div>
        </div>
    }
</div>
