@model QuranCenterApp.Models.Gift
@{
    ViewData["Title"] = "تعديل الهدية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-pencil-square me-2" style="color:var(--gold)"></i>تعديل الهدية</h2>
        <p class="page-subtitle">@Model.GiftName</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>رجوع</a>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-pencil me-2" style="color:var(--gold)"></i>تعديل: @Model.GiftName</div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="GiftID" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">اسم الهدية <span class="text-danger">*</span></label>
                    <input asp-for="GiftName" class="form-control" required />
                    <span asp-validation-for="GiftName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">نوع الهدية</label>
                    <select asp-for="GiftType" class="form-select">
                        <option value="كتاب">كتاب</option>
                        <option value="هدية">هدية</option>
                        <option value="جائزة">جائزة</option>
                        <option value="مشروب">مشروب</option>
                        <option value="غذاء">غذاء</option>
                        <option value="قرطاسية">قرطاسية</option>
                        <option value="أخرى">أخرى</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">الكمية</label>
                    <input asp-for="Quantity" type="number" min="0" class="form-control" required />
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-gold px-4"><i class="bi bi-save me-1"></i>تحديث</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>
