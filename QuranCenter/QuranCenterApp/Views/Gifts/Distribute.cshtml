@model QuranCenterApp.Models.GiftDistribution
@{
    ViewData["Title"] = "توزيع هدية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-gift me-2" style="color:var(--gold)"></i>توزيع هدية</h2>
        <p class="page-subtitle">اختر الهدية والطالب المستحق</p>
    </div>
    <a asp-action="Distributions" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>قائمة التوزيعات
    </a>
</div>

<div class="card" style="max-width:600px">
    <div class="card-header" style="color:var(--gold)">
        <i class="bi bi-box-arrow-right me-2"></i>بيانات التوزيع
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-3">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div><i class="bi bi-exclamation-triangle me-1"></i>@error.ErrorMessage</div>
                }
            </div>
        }
        <form asp-action="Distribute" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">الهدية <span class="text-danger">*</span></label>
                    <select asp-for="GiftID" asp-items="ViewBag.GiftID" class="form-select" required>
                        <option value="">-- اختر هدية --</option>
                    </select>
                    <small style="color:var(--text-muted)">تظهر فقط الهدايا المتوفرة</small>
                </div>
                <div class="col-12">
                    <label class="form-label">الطالب <span class="text-danger">*</span></label>
                    <select asp-for="StudentID" asp-items="ViewBag.StudentID" class="form-select" required>
                        <option value="">-- اختر طالباً --</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">تاريخ التوزيع <span class="text-danger">*</span></label>
                    <input asp-for="DateReceived" type="date" lang="en-GB" dir="ltr" class="form-control" />
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-gold px-4">
                    <i class="bi bi-gift me-1"></i>توزيع الهدية
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

