@{
    ViewData["Title"] = "لوحة التحكم";
}

<!-- Islamic header decoration -->
<div class="text-center mb-3" style="color:var(--gold);font-size:1.2rem;letter-spacing:8px;opacity:.6">
    ✦ &nbsp; ☪ &nbsp; ✦ &nbsp; ☽ &nbsp; ✦
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-speedometer2 me-2" style="color:var(--gold)"></i>لوحة التحكم</h2>
        <p class="page-subtitle">أهلاً بكم في نظام إدارة مركز تحفيظ القرآن الكريم</p>
    </div>
    <span class="badge px-3 py-2" style="background:var(--bg-card);color:var(--gold);border:1px solid var(--border);font-size:.9rem">
        ☪ @DateTime.Today.ToString("dd MMMM yyyy")
    </span>
</div>

<!-- بطاقات الإحصائيات -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white h-100" style="background:linear-gradient(135deg,#1a6b3a,#2d9a57)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.StudentCount</div>
                    <div class="small opacity-75">إجمالي الطلاب</div>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Students" asp-action="Index" class="text-white text-decoration-none small">
                    عرض الكل <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white h-100" style="background:linear-gradient(135deg,#0d47a1,#1976d2)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.TeacherCount</div>
                    <div class="small opacity-75">المعلمون</div>
                </div>
                <i class="bi bi-person-badge fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Teachers" asp-action="Index" class="text-white text-decoration-none small">
                    عرض الكل <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white h-100" style="background:linear-gradient(135deg,#7b4f00,#c8a84b)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.ClassroomCount</div>
                    <div class="small opacity-75">الفصول الدراسية</div>
                </div>
                <i class="bi bi-door-open fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Classrooms" asp-action="Index" class="text-white text-decoration-none small">
                    عرض الكل <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white h-100" style="background:linear-gradient(135deg,#4a1a6b,#7b3db5)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.GiftCount</div>
                    <div class="small opacity-75">هدايا في المخزون</div>
                </div>
                <i class="bi bi-gift fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Gifts" asp-action="Index" class="text-white text-decoration-none small">
                    إدارة الهدايا <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Islamic divider -->
<div class="islamic-divider mb-4">❧ &nbsp; ✦ &nbsp; ﷽ &nbsp; ✦ &nbsp; ❧</div>

<!-- الإجراءات السريعة -->
<div class="card mb-4">
    <div class="card-header" style="color:var(--gold)">
        <i class="bi bi-lightning-charge me-2"></i>الإجراءات السريعة
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a asp-controller="Students"    asp-action="Create"    class="btn btn-gold"><i class="bi bi-person-plus me-1"></i>إضافة طالب</a>
            <a asp-controller="Teachers"    asp-action="Create"    class="btn btn-gold"><i class="bi bi-person-badge me-1"></i>إضافة معلم</a>
            <a asp-controller="Classrooms"  asp-action="Create"    class="btn btn-gold"><i class="bi bi-plus-circle me-1"></i>فصل جديد</a>
            <a asp-controller="Attendance"  asp-action="Create"    class="btn btn-gold"><i class="bi bi-calendar-plus me-1"></i>تسجيل حضور</a>
            <a asp-controller="Memorization" asp-action="Create"   class="btn btn-gold"><i class="bi bi-bookmark-plus me-1"></i>إضافة حفظ</a>
            <a asp-controller="Gifts"       asp-action="Distribute" class="btn btn-gold"><i class="bi bi-gift me-1"></i>توزيع هدية</a>
        </div>
    </div>
</div>

<!-- تواصل معنا -->
<div class="card" style="border-right: 4px solid var(--gold) !important">
    <div class="card-header">
        <i class="bi bi-chat-heart me-2" style="color:var(--gold)"></i>تواصل معنا
    </div>
    <div class="card-body">

        <!-- نوع الرسالة -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="type-card p-3 text-center rounded" id="card-support" onclick="selectType('support')"
                     role="button" tabindex="0" aria-label="دعم تقني"
                     style="border:2px solid var(--border);cursor:pointer;transition:all 200ms ease-out;background:var(--bg-row)">
                    <i class="bi bi-tools" style="font-size:2rem;color:var(--gold)"></i>
                    <div style="color:#fff;font-weight:600;margin-top:6px">دعم تقني</div>
                    <div style="color:var(--text-muted);font-size:.8rem">مشكلة أو خطأ في النظام</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="type-card p-3 text-center rounded" id="card-idea" onclick="selectType('idea')"
                     role="button" tabindex="0" aria-label="اقتراح فكرة"
                     style="border:2px solid var(--border);cursor:pointer;transition:all 200ms ease-out;background:var(--bg-row)">
                    <i class="bi bi-lightbulb" style="font-size:2rem;color:var(--gold)"></i>
                    <div style="color:#fff;font-weight:600;margin-top:6px">اقتراح فكرة</div>
                    <div style="color:var(--text-muted);font-size:.8rem">تحسين أو ميزة جديدة</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="type-card p-3 text-center rounded" id="card-complaint" onclick="selectType('complaint')"
                     role="button" tabindex="0" aria-label="شكوى"
                     style="border:2px solid var(--border);cursor:pointer;transition:all 200ms ease-out;background:var(--bg-row)">
                    <i class="bi bi-megaphone" style="font-size:2rem;color:var(--gold)"></i>
                    <div style="color:#fff;font-weight:600;margin-top:6px">شكوى</div>
                    <div style="color:var(--text-muted);font-size:.8rem">ملاحظة أو تظلّم</div>
                </div>
            </div>
        </div>

        <!-- نموذج الرسالة -->
        <div id="feedback-form" style="display:none">
            <div class="mb-3">
                <label class="form-label">الاسم (اختياري)</label>
                <input type="text" id="fb-name" class="form-control" placeholder="اسمك" />
            </div>
            <div class="mb-3">
                <label class="form-label">الرسالة <span class="text-danger">*</span></label>
                <textarea id="fb-message" class="form-control" rows="4" placeholder="اكتب رسالتك هنا..."></textarea>
            </div>
            <button class="btn btn-gold px-4" onclick="submitFeedback()">
                <i class="bi bi-send me-1"></i>إرسال
            </button>
            <button class="btn btn-outline-secondary ms-2" onclick="cancelFeedback()">إلغاء</button>
        </div>

        <!-- رسالة النجاح -->
        <div id="feedback-success" style="display:none" class="text-center py-4" role="status" aria-live="polite">
            <i class="bi bi-check-circle-fill" style="font-size:3rem;color:var(--gold)"></i>
            <h5 style="color:var(--gold)" class="mt-2">شكراً لتواصلك معنا!</h5>
            <p style="color:var(--text-muted)">تم استلام رسالتك وسنرد عليك في أقرب وقت.</p>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetFeedback()">إرسال رسالة أخرى</button>
        </div>

    </div>
</div>

<script>
var selectedType = '';
function selectType(type) {
    selectedType = type;
    ['support','idea','complaint'].forEach(function(t) {
        var c = document.getElementById('card-' + t);
        c.style.borderColor = (t === type) ? 'var(--gold)' : 'var(--border)';
        c.style.background  = (t === type) ? 'rgba(200,168,75,.15)' : 'var(--bg-row)';
    });
    document.getElementById('feedback-form').style.display = 'block';
    document.getElementById('feedback-success').style.display = 'none';
}
function submitFeedback() {
    var msg = document.getElementById('fb-message').value.trim();
    if (!msg) { alert('الرجاء كتابة رسالتك أولاً'); return; }
    document.getElementById('feedback-form').style.display = 'none';
    document.getElementById('feedback-success').style.display = 'block';
}
function cancelFeedback() {
    document.getElementById('feedback-form').style.display = 'none';
    resetTypeCards();
}
function resetFeedback() {
    document.getElementById('feedback-success').style.display = 'none';
    document.getElementById('fb-name').value = '';
    document.getElementById('fb-message').value = '';
    document.getElementById('feedback-form').style.display = 'none';
    resetTypeCards();
}
function resetTypeCards() {
    ['support','idea','complaint'].forEach(function(t) {
        var c = document.getElementById('card-' + t);
        c.style.borderColor = 'var(--border)';
        c.style.background  = 'var(--bg-row)';
    });
    selectedType = '';
}
</script>
